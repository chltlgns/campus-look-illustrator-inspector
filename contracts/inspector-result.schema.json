{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campuslook.local/contracts/inspector-result.schema.json",
  "title": "Campuslook Illustrator Inspector report",
  "type": "object",
  "required": [
    "schemaVersion",
    "document",
    "designCount",
    "overallStatus",
    "designs",
    "performance",
    "catalogProvenance",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "document": { "type": "string", "minLength": 1 },
    "designCount": { "type": "integer", "minimum": 1 },
    "overallStatus": { "$ref": "#/$defs/status" },
    "designs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/design" }
    },
    "performance": { "type": ["object", "null"] },
    "catalogProvenance": {
      "type": "object",
      "required": ["coverage", "catalogs"],
      "properties": {
        "coverage": { "enum": ["current-only", "full"] },
        "catalogs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["catalogId", "role", "generation", "sourceSha256", "extractorVersion", "entryCount"],
            "properties": {
              "catalogId": { "type": "string", "minLength": 1 },
              "role": { "enum": ["current-body", "legacy-body", "sleeve-material"] },
              "generation": { "type": "string", "minLength": 1 },
              "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "extractorVersion": { "type": "string", "minLength": 1 },
              "entryCount": { "type": "integer", "minimum": 1 },
              "referenceState": { "type": "object" }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "object",
      "required": ["lining", "shapeChecks", "colorProfiles", "materialAuthentication"],
      "properties": {
        "lining": { "type": "string" },
        "shapeChecks": { "type": "string" },
        "colorProfiles": { "type": "string" },
        "materialAuthentication": { "type": "string" }
      }
    }
  },
  "$defs": {
    "status": { "enum": ["PASS", "REVIEW", "FAIL"] },
    "check": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "reason": { "type": "string" },
        "decisionCode": { "type": "string" },
        "matchedCatalog": { "type": ["object", "null"] },
        "candidates": { "type": "array" },
        "nearest": { "type": "array" }
      }
    },
    "design": {
      "type": "object",
      "required": [
        "id",
        "label",
        "proofArtboard",
        "fields",
        "sleeveSpecification",
        "visual",
        "materialCheck",
        "sleeveCheck",
        "tableCheck",
        "overallStatus"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "proofArtboard": {
          "type": "object",
          "required": ["index", "name", "render"],
          "properties": {
            "index": { "type": "integer", "minimum": 0 },
            "name": { "type": "string" },
            "render": { "type": "string", "minLength": 1 }
          }
        },
        "fields": { "type": "object" },
        "sleeveSpecification": { "type": "object" },
        "visual": { "type": "object" },
        "materialCheck": { "$ref": "#/$defs/check" },
        "sleeveCheck": { "$ref": "#/$defs/check" },
        "tableCheck": { "$ref": "#/$defs/check" },
        "overallStatus": { "$ref": "#/$defs/status" }
      }
    }
  }
}
