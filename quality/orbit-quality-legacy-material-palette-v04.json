      "command": ["{python}", "/mnt/d/AI-Workflow/cli/orbit.py", "validation", "run", "--repo", ".", "--profile", "quality/orbit-validation-legacy-material-palette-v04.json", "--json"],
      "version_command": ["{python}", "--version"],
      "timeout_seconds": 900,
      "requirement": "always",
      "evidence": "orbit-validation-receipt/v1"
    },
    {
      "id": "approved-base-ancestry",
      "globs": ["*", "**/*"],
      "command": ["{git}", "merge-base", "--is-ancestor", "09245e629800aff12fc64bae026dd96e4abc6dc1", "HEAD"],
      "version_command": ["{git}", "--version"],
      "timeout_seconds": 60,
      "requirement": "always"
    },
    {
      "id": "patch-hygiene",
      "globs": ["*", "**/*"],
      "command": ["{git}", "diff", "--check", "09245e629800aff12fc64bae026dd96e4abc6dc1", "HEAD"],
      "version_command": ["{git}", "--version"],
      "timeout_seconds": 60,
      "requirement": "always"
    }
  ]
}
